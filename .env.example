# .env.example — Harness Extension
# JANGAN isi file ini lalu commit. Salin jadi .env di mesinmu (untuk companion),
# atau isi file .env pribadimu lalu IMPORT lewat Settings -> Koneksi di extension.
# Semua nilai secret akan disimpan TERENKRIPSI (SecretVault, AES-GCM) di perangkat.

# --- LLM Providers (isi yang dipakai saja, boleh lebih dari satu) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

# OpenAI-compatible lain: Groq / DeepSeek / Mistral / Together / OpenRouter / xAI
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=

# LLM lokal (tanpa API key)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Platform Bridge (5e) ---
PLATFORM_URL=
INGEST_TOKEN=

# --- LocalBridge / terminal companion (5c) ---
LOCAL_BRIDGE_PORT=
LOCAL_BRIDGE_PAIRING_TOKEN=